def normalize_ntfs_inspection(value, snapshot, source):
    fields = {'schemaVersion', 'deviceBytes', 'volumeBytes', 'clusterBytes', 'minimumBytes', 'inspectionFingerprint'}
    if not isinstance(value, dict) or set(value) != fields or type(value['schemaVersion']) is not int or value['schemaVersion'] != 1:
        raise ValueError('Invalid NTFS inspection')
    size = (source['endSector'] - source['startSector'] + 1) * snapshot['logicalSectorBytes']
    sector = snapshot['logicalSectorBytes']
    if (type(value['deviceBytes']) is not int or value['deviceBytes'] != size or size > 8 * 1024**4
            or type(value['clusterBytes']) is not int or not sector <= value['clusterBytes'] <= 65536
            or value['clusterBytes'] & (value['clusterBytes'] - 1)
            or type(value['volumeBytes']) is not int or not sector <= value['volumeBytes'] <= size
            or size - value['volumeBytes'] >= value['clusterBytes']
            or (value['volumeBytes'] - sector) % value['clusterBytes']
            or type(value['minimumBytes']) is not int or not 0 < value['minimumBytes'] <= value['volumeBytes']
            or value['minimumBytes'] % sector
            or not isinstance(value['inspectionFingerprint'], str)
            or not re.fullmatch('[0-9a-f]{64}', value['inspectionFingerprint'])):
        raise ValueError('Invalid NTFS inspection geometry')
    return dict(value)


def ntfs_module():
    loader = importlib.machinery.SourceFileLoader('ro_helper_ntfs', str(Path(__file__).with_name('ro_installer_ntfs.py')))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec); loader.exec_module(module)
    return module


def normalize_ntfs_preparation(value, snapshot, source, target, fingerprint):
    if not isinstance(value, dict) or set(value) != {'inspection','preparation'}:
        raise ValueError('Invalid NTFS preparation evidence')
    inspection = normalize_ntfs_inspection(value['inspection'], snapshot, source)
    prepared = value['preparation']
    if (not isinstance(prepared, dict) or set(prepared) != {'schemaVersion','deviceBytes','targetBytes',
            'inspectionFingerprint','toolchain','preparationFingerprint'}
            or type(prepared['schemaVersion']) is not int or prepared['schemaVersion'] != 1
            or type(prepared['deviceBytes']) is not int or prepared['deviceBytes'] != inspection['deviceBytes']
            or type(prepared['targetBytes']) is not int or prepared['targetBytes'] != target
            or type(target) is not int or target % 1048576 or not 40*1024**3 <= target < inspection['deviceBytes']
            or target < inspection['minimumBytes'] + 1024**3
            or inspection['inspectionFingerprint'] != fingerprint or prepared['inspectionFingerprint'] != fingerprint
            or not isinstance(prepared['preparationFingerprint'], str)
            or not re.fullmatch('[0-9a-f]{64}', prepared['preparationFingerprint'])):
        raise ValueError('NTFS preparation does not bind the source and target')
    tools = prepared['toolchain']
    if (not isinstance(tools, dict) or set(tools) != {'version','epoch','release','arch'}
            or type(tools['epoch']) is not int):
        raise ValueError('Invalid NTFS toolchain evidence')
    version = f"ntfsresize v{tools['version']} (libntfs-3g)\n".encode()
    packages = ''.join(f"{name}|{tools['epoch']}|{tools['version']}|{tools['release']}|{tools['arch']}\n"
                       for name in ('ntfsprogs','ntfs-3g-libs')).encode()
    if not same_plan_value(ntfs_module().qualify_resize_toolchain(version, packages), tools):
        raise ValueError('Noncanonical NTFS toolchain evidence')
    return {'inspection':inspection, 'preparation':{**prepared, 'toolchain':dict(tools)}}


def normalize_ntfs_prepared_plan(value, proposal, fingerprint):
    if not isinstance(value, dict) or set(value) != {'plan','inspection','preparation'}:
        raise ValueError('Invalid NTFS prepared plan')
    module = gpt_module()
    preliminary = module.ntfs_shrink_plan({**proposal,'minimumFilesystemBytes':1})
    evidence = normalize_ntfs_preparation({'inspection':value['inspection'],'preparation':value['preparation']},
        proposal['snapshot'], preliminary['source'], preliminary['source']['retainedBytes'], fingerprint)
    computed = module.ntfs_shrink_plan({**proposal,'minimumFilesystemBytes':evidence['inspection']['minimumBytes']})
    if not same_plan_value(value['plan'], computed):raise ValueError('NTFS prepared geometry mismatch')
    return {'plan':computed, **evidence}


def read_request(fd):
    deadline = time.monotonic() + REQUEST_TIMEOUT
    raw = bytearray()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
            fail("REQUEST_TIMEOUT", "Request was not completed before the deadline.")
        chunk = os.read(fd, min(4096, MAX_REQUEST_BYTES + 1 - len(raw)))
        if not chunk:
            return bytes(raw)
        raw.extend(chunk)
        if len(raw) > MAX_REQUEST_BYTES:
            fail("REQUEST_TOO_LARGE", "Request exceeds the protocol size limit.")


def mount_unescape(value):
    return re.sub(r"\\(040|011|012|134)", lambda m: chr(int(m[1], 8)), value)


@dataclasses.dataclass(frozen=True)
class Mount:
    number: str
    target: str
    filesystem: str
    source: str
    options: str


def parse_mounts(text):
    mounts = []
    for line in text.splitlines():
        left, separator, right = line.partition(" - ")
        fields, extra = left.split(), right.split()
        if not separator or len(fields) < 6 or len(extra) != 3:
            fail("AMBIGUOUS_TOPOLOGY", "Mount topology cannot be parsed.")
        target = mount_unescape(fields[4])
        if not target.startswith("/"):
            fail("AMBIGUOUS_TOPOLOGY", "Mount topology contains an invalid path.")
        mounts.append(Mount(device_number(fields[2]), target, extra[0],
                            mount_unescape(extra[1]), extra[2]))
    if sum(m.target == "/" for m in mounts) != 1:
        fail("AMBIGUOUS_TOPOLOGY", "Root mount is missing or ambiguous.")
    if len({m.target for m in mounts}) != len(mounts):
        fail("AMBIGUOUS_TOPOLOGY", "Stacked mounts require additional validation.")
    return mounts


class System:
    """Fixed OS reads and one fixed read-only tool. No caller-controlled argv."""

    def lsblk(self):
        # Stream both pipes with a shared byte/deadline limit; never echo stderr.
        with subprocess.Popen(LSBLK_ARGV, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              env=CHILD_ENV, close_fds=True,
                              pass_fds=() if getattr(self, "lease_fd", None) is None else (self.lease_fd,)) as process:
            streams = [process.stdout, process.stderr]
            output = bytearray()
            total = 0
            deadline = time.monotonic() + TOOL_TIMEOUT
            try:
                while streams:
                    remaining = deadline - time.monotonic()
                    ready = select.select(streams, [], [], max(0, remaining))[0]
                    if remaining <= 0 or not ready:
                        fail("SYSTEM_ERROR", "Block topology query timed out.")
                    for stream in ready:
                        chunk = os.read(stream.fileno(), 4096)
                        total += len(chunk)
                        if total > MAX_TOPOLOGY_BYTES:
                            fail("AMBIGUOUS_TOPOLOGY", "Block topology exceeds the safety limit.")
                        if not chunk:
                            streams.remove(stream)
                        elif stream is process.stdout:
                            output.extend(chunk)
                if process.wait(timeout=max(0.01, deadline - time.monotonic())) != 0:
                    fail("SYSTEM_ERROR", "Block topology query failed.")
            finally:
                if process.poll() is None:
                    process.kill()
                    process.wait(timeout=1)
        try:
            return json.loads(output, object_pairs_hook=unique_object)
        except (ValueError, RecursionError):
            fail("AMBIGUOUS_TOPOLOGY", "Invalid block topology JSON.")

    def mounts(self):
        return Path("/proc/self/mountinfo").read_text()

    def gpt_snapshot(self, device, preserve_slots=None, manual_roles=None, layout_slots=None, admit_manual=False, ntfs_layout=None):
        if sum(value is not None for value in (preserve_slots,manual_roles,layout_slots,ntfs_layout)) > 1:
            fail('INVALID_REQUEST','Conflicting probe modes.')
        if ntfs_layout is not None:
            try:ntfs_layout=gpt_module().normalize_ntfs_layout(ntfs_layout)
            except (ValueError,TypeError,KeyError):fail('INVALID_REQUEST','Invalid NTFS preservation slots.')
        gpt_args=(*GPT_ARGV,device.path,json.dumps(device.public(),separators=(',',':')))
        if ntfs_layout is not None:gpt_args+=('--ntfs-layout',json.dumps(ntfs_layout,separators=(',',':')))
        if preserve_slots is not None:gpt_args+=('--preserve-slots',json.dumps(preserve_slots))
        if manual_roles is not None:
            if preserve_slots is not None:fail('INVALID_REQUEST','Conflicting probe modes.')
            gpt_args=(*MANUAL_ARGV,device.path,json.dumps(device.public(),separators=(',',':')),json.dumps(manual_roles,separators=(',',':')))
        if admit_manual:
            if manual_roles is None:fail('INVALID_REQUEST','Manual roles required.')
            gpt_args=(*MANUAL_ARGV,'--admit',device.path,json.dumps(device.public(),separators=(',',':')),json.dumps(manual_roles,separators=(',',':')))
        if layout_slots is not None:
            if preserve_slots is not None or manual_roles is not None:fail('INVALID_REQUEST','Conflicting probe modes.')
            gpt_args=(*MANUAL_ARGV,'--layout',device.path,json.dumps(device.public(),separators=(',',':')),json.dumps(layout_slots,separators=(',',':')))
        child_env=CHILD_ENV
        if manual_roles is not None and getattr(self,'lease_fd',None) is not None:
            child_env=dict(CHILD_ENV,RO_INSTALLER_LEASE_FD=str(self.lease_fd))
        process=subprocess.Popen(gpt_args,
            stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,env=child_env,close_fds=True,
            pass_fds=() if getattr(self,'lease_fd',None) is None else (self.lease_fd,))
        output=bytearray();total=0;streams=[process.stdout,process.stderr];deadline=time.monotonic()+(30 if admit_manual else GPT_TIMEOUT)
        try:
            while streams:
                remaining=deadline-time.monotonic()
                ready=select.select(streams,[],[],max(0,remaining))[0]
                if remaining<=0 or not ready:fail('SYSTEM_ERROR','GPT probe exceeded its deadline.')
                for stream in ready:
                    chunk=os.read(stream.fileno(),4096);total+=len(chunk)
                    if total>8192:fail('AMBIGUOUS_TOPOLOGY','GPT probe output exceeded its safety limit.')
                    if not chunk:streams.remove(stream)
                    elif stream is process.stdout:output.extend(chunk)
            if process.wait(timeout=max(0.01,deadline-time.monotonic()))!=0:
                fail('AMBIGUOUS_TOPOLOGY','GPT metadata could not be verified.')
            try:
                value=json.loads(output,object_pairs_hook=unique_object,parse_constant=lambda _:fail('AMBIGUOUS_TOPOLOGY','Invalid GPT number.'))
                if manual_roles is not None:
                    if not isinstance(value,dict) or set(value)!={'snapshot','plan'}:raise ValueError()
                    snapshot=gpt_module().normalize_snapshot(value['snapshot'],device.public())
                    computed=gpt_module().manual_plan(snapshot,manual_roles)
                    if not same_plan_value(computed,value['plan']):raise ValueError()
                    return {'snapshot':snapshot,'plan':computed}
                if preserve_slots is None and layout_slots is None and ntfs_layout is None:return gpt_module().normalize_snapshot(value,device.public())
                if (not isinstance(value,dict) or set(value)!={'snapshot','preservationFingerprint'} or not isinstance(value['preservationFingerprint'],str)
                        or not re.fullmatch('[0-9a-f]{64}',value['preservationFingerprint'])):raise ValueError()
                return {'snapshot':gpt_module().normalize_snapshot(value['snapshot'],device.public()),'preservationFingerprint':value['preservationFingerprint']}
            except (ValueError,UnicodeError,TypeError,KeyError,RecursionError):
                fail('AMBIGUOUS_TOPOLOGY','Invalid normalized GPT snapshot.')
        except subprocess.TimeoutExpired:
            fail('SYSTEM_ERROR','GPT probe exceeded its deadline.')
        finally:
            if process.poll() is None:
                try:process.kill()
                except ProcessLookupError:pass
            try:process.wait(timeout=1)
            except subprocess.TimeoutExpired:pass  # An uninterruptible reader retains the inherited lease.
            process.stdout.close();process.stderr.close()

    def swaps(self):
        return Path("/proc/swaps").read_text()

    def path_identity(self, path, *, block=False):
        info = os.stat(path)
        if block and not stat.S_ISBLK(info.st_mode):
            fail("NOT_BLOCK_DEVICE", "Selected path is not a block device.")
        dev = info.st_rdev if block else info.st_dev
        return f"{os.major(dev)}:{os.minor(dev)}"

    def loop_backing(self, number, path):
        # LOOP_GET_STATUS64 reports the actual open backing file's superblock
        # device, even when backing_file names a path from before pivot_root.
        # Never relocate that filename by guessing a live-media mount prefix.
        if not re.fullmatch(r"7:[0-9]+", number) or path != "/dev/loop" + number.split(":")[1]:
            fail("AMBIGUOUS_TOPOLOGY", "Loop device identity is unsupported.")
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            info = os.fstat(fd)
            if not stat.S_ISBLK(info.st_mode) or f"{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}" != number:
                fail("AMBIGUOUS_TOPOLOGY", "Loop device changed during validation.")
            raw = fcntl.ioctl(fd, 0x4C05, bytes(232))  # linux/loop.h, struct loop_info64
            device, inode, rdevice = struct.unpack_from("=QQQ", raw)
            loop_number = struct.unpack_from("=I", raw, 40)[0]
            if device >> 32 or inode == 0 or rdevice != 0 or loop_number != os.minor(info.st_rdev):
                fail("AMBIGUOUS_TOPOLOGY", "Loop backing identity is unsupported.")
            # huge_encode_dev/new_encode_dev, not the kernel's internal dev_t.
            major = (device >> 8) & 0xfff
            minor = (device & 0xff) | ((device >> 12) & 0xfff00)
            return f"{major}:{minor}"
        finally:
            os.close(fd)

    def sysfs(self, number):
        directory = Path("/sys/dev/block", number).resolve(strict=True)
        if not str(directory).startswith("/sys/devices/"):
            fail("AMBIGUOUS_TOPOLOGY", "Unexpected sysfs device location.")
        if device_number((directory / "dev").read_text().strip()) != number:
            fail("DEVICE_CHANGED", "Device identity changed during validation.")
        parents = {device_number((entry / "dev").read_text().strip())
                   for entry in (directory / "slaves").iterdir()} if (directory / "slaves").is_dir() else set()
        partition = (directory / "partition").exists()
        if partition:
            parents.add(device_number((directory.parent / "dev").read_text().strip()))
        loop_file = directory / "loop/backing_file"
        sequence = directory / "diskseq"
        return {
            "path": str(directory), "partition": partition, "parents": parents,
            "size": int((directory / "size").read_text().strip()) * 512,
            "diskSequence": int(sequence.read_text().strip()) if sequence.exists() else None,
            "backingFile": loop_file.read_text().strip() if loop_file.exists() else None,
        }

    def platform_supported(self):
        return platform.machine() == "x86_64" and Path("/sys/firmware/efi").is_dir()

    def prepare_ntfs(self, snapshot, source, target, fingerprint):
        return self.inspect_ntfs(snapshot, source, target_bytes=target, inspection_fingerprint=fingerprint)

    def inspect_ntfs(self, snapshot, source, *, target_bytes=None, inspection_fingerprint=None):
        """Bind the private reader to one observed partition under the lease."""
        worker = manual_module()
        fd = None
        try:
            path, number = worker.partition_descriptor(snapshot, source)
            fd = os.open(path, os.O_RDONLY | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
            if (worker.partition_descriptor(snapshot, source, fd) != (path, number)
                    or struct.unpack('=I', fcntl.ioctl(fd, 0x1268, bytes(4)))[0] != snapshot['logicalSectorBytes']):
                raise ValueError('Source partition changed')
            size = (source['endSector'] - source['startSector'] + 1) * snapshot['logicalSectorBytes']
            value = (self.ntfs_worker(fd, size, snapshot['logicalSectorBytes']) if target_bytes is None else
                self.ntfs_worker(fd, size, snapshot['logicalSectorBytes'], target_bytes=target_bytes,
                                 inspection_fingerprint=inspection_fingerprint))
            if (worker.partition_descriptor(snapshot, source, fd) != (path, number)
                    or struct.unpack('=I', fcntl.ioctl(fd, 0x1268, bytes(4)))[0] != snapshot['logicalSectorBytes']):
                raise ValueError('Source partition changed')
            return (normalize_ntfs_inspection(value, snapshot, source) if target_bytes is None else
                normalize_ntfs_preparation(value, snapshot, source, target_bytes, inspection_fingerprint))
        except (OSError, ValueError, TypeError, KeyError):
            fail('AMBIGUOUS_TOPOLOGY', 'NTFS source could not be safely inspected.')
        finally:
            if fd is not None: os.close(fd)

    def ntfs_worker(self, fd, size, sector, *, target_bytes=None, inspection_fingerprint=None):
        lease = getattr(self, 'lease_fd', None)
        if type(lease) is not int or lease < 3 or lease == fd or not stat.S_ISREG(os.fstat(lease).st_mode):
            fail('UNSAFE_LOCK', 'NTFS inspection requires the installation lease.')
        preparing = target_bytes is not None
        if preparing:
            if (type(target_bytes) is not int or not 40*1024**3 <= target_bytes < size or target_bytes % 1048576
                    or not isinstance(inspection_fingerprint,str) or not re.fullmatch('[0-9a-f]{64}',inspection_fingerprint)):
                fail('INVALID_REQUEST','Invalid exact NTFS preparation target.')
            ntfs_args = (*NTFS_PREPARE_ARGV,str(fd),str(size),str(sector),str(target_bytes),inspection_fingerprint)
        else:
            if inspection_fingerprint is not None:fail('INVALID_REQUEST','Unexpected NTFS fingerprint.')
            ntfs_args = (*NTFS_ARGV, str(fd), str(size), str(sector))
        process = None
        try:
            process = subprocess.Popen(ntfs_args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                close_fds=True, pass_fds=(fd, lease), env={**CHILD_ENV, 'RO_INSTALLER_LEASE_FD': str(lease)},
                start_new_session=True)
            streams = [process.stdout, process.stderr]; output = bytearray(); total = 0
            deadline = time.monotonic() + (NTFS_PREPARE_TIMEOUT if preparing else NTFS_TIMEOUT)
            while streams:
                remaining = deadline - time.monotonic()
                ready = select.select(streams, [], [], max(0, remaining))[0]
                if remaining <= 0 or not ready:
                    fail('SYSTEM_ERROR', 'NTFS inspection exceeded its deadline.')
                for stream in ready:
                    chunk = os.read(stream.fileno(), 1024); total += len(chunk)
                    if total > 2048:
                        fail('AMBIGUOUS_TOPOLOGY', 'NTFS inspection output exceeded its safety limit.')
                    if not chunk: streams.remove(stream)
                    elif stream is process.stdout: output.extend(chunk)
            # Reserve the leader PID until its process group has been stopped.
            # Popen.poll/wait here would reap it and allow PID/PGID reuse.
            while True:
                status = os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOWAIT | os.WNOHANG)
                if status is not None: break
                if time.monotonic() >= deadline:
                    fail('SYSTEM_ERROR', 'NTFS inspection exceeded its deadline.')
                time.sleep(0.01)
            if status.si_code != os.CLD_EXITED or status.si_status != 0:
                if preparing and status.si_code == os.CLD_EXITED and status.si_status == 2:
                    try:
                        refusal = json.loads(output,object_pairs_hook=unique_object,parse_constant=lambda _: None)
                    except (ValueError,TypeError,UnicodeError,HelperError): refusal = None
                    if same_plan_value(refusal,{'error':'NTFS_TOOLS_UNSUPPORTED'}):
                        fail('NTFS_TOOLS_UNSUPPORTED','Matching NTFS tools version 2026.9.28 or newer are required.')
                fail('AMBIGUOUS_TOPOLOGY', 'NTFS metadata could not be verified.')
            try:
                return json.loads(output, object_pairs_hook=unique_object,
                                  parse_constant=lambda _: fail('AMBIGUOUS_TOPOLOGY', 'Invalid NTFS number.'))
            except (HelperError, ValueError, UnicodeError, TypeError, RecursionError):
                fail('AMBIGUOUS_TOPOLOGY', 'Invalid NTFS inspection result.')
        except OSError:
            fail('SYSTEM_ERROR', 'NTFS inspection transport failed.')
        finally:
            if process is not None:
                try: os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError: pass
                try: process.wait(timeout=1)
                except subprocess.TimeoutExpired: pass  # An uninterruptible child retains its lease.
                process.stdout.close(); process.stderr.close()

    def audit(self):
        return {"effectiveUid": os.geteuid(), "architecture": platform.machine(),
                "uefi": Path("/sys/firmware/efi").is_dir(),
                "operations": sorted(OPERATIONS), "installationImplemented": True}


@dataclasses.dataclass(frozen=True)
class Device:
    path: str
    major_minor: str
    size: int
    disk_sequence: int
    sysfs_path: str

    def public(self):
        return {"path": self.path, "majorMinor": self.major_minor,
                "size": self.size, "diskSequence": self.disk_sequence}


class Topology:
    def __init__(self, system):
        self.system = system
        self.nodes = {}
        self.tree_parents = {}
        self.mounts = parse_mounts(system.mounts())
        data = system.lsblk()
        if not isinstance(data, dict) or not isinstance(data.get("blockdevices"), list):
            fail("AMBIGUOUS_TOPOLOGY", "Missing block topology.")
        self._collect(data["blockdevices"])
        paths = {node["name"]: number for number, node in self.nodes.items()}
        if len(paths) != len(self.nodes):
            fail("AMBIGUOUS_TOPOLOGY", "Conflicting device paths.")
        for number, node in self.nodes.items():
            if node.get("pkname"):
                if node["pkname"] not in paths:
                    fail("AMBIGUOUS_TOPOLOGY", "Unknown parent device.")
                self.tree_parents[number].add(paths[node["pkname"]])

    def _collect(self, entries, parent=None, depth=0):
        if depth > 32 or len(self.nodes) > 4096:
            fail("AMBIGUOUS_TOPOLOGY", "Block topology is too complex.")
        for raw in entries:
            if not isinstance(raw, dict):
                fail("AMBIGUOUS_TOPOLOGY", "Invalid block topology entry.")
            number = device_number(raw.get("maj:min"))
            if (not isinstance(raw.get("name"), str) or not raw["name"].startswith("/dev/")
                    or not isinstance(raw.get("type"), str)
                    or type(raw.get("size")) is not int or raw["size"] < 0
                    or raw.get("pkname") is not None and not isinstance(raw["pkname"], str)
                    or type(raw.get("ro")) is not bool or type(raw.get("rm")) is not bool):
                fail("AMBIGUOUS_TOPOLOGY", "Incomplete block topology entry.")
            node = {key: raw.get(key) for key in ("name", "type", "size", "pkname", "ro", "rm")}
            if number in self.nodes and self.nodes[number] != node:
                fail("AMBIGUOUS_TOPOLOGY", "Conflicting block device identities.")
            self.nodes[number] = node
            self.tree_parents.setdefault(number, set())
            if parent is not None:
                self.tree_parents[number].add(parent)
            children = raw.get("children", [])
            if not isinstance(children, list):
                fail("AMBIGUOUS_TOPOLOGY", "Invalid block device children.")
            self._collect(children, number, depth + 1)

    def ancestors(self, number, active=frozenset()):
        key = ("device", number)
        if key in active or len(active) > 64 or number not in self.nodes:
            fail("AMBIGUOUS_TOPOLOGY", "Unresolved or cyclic block ancestry.")
        active = active | {key}
        info = self.system.sysfs(number)
        if (info["size"] != self.nodes[number]["size"]
                or info["parents"] != self.tree_parents[number]):
            fail("AMBIGUOUS_TOPOLOGY", "lsblk and sysfs disagree about block ancestry.")
        result = {number}
        for parent in info["parents"]:
            result.update(self.ancestors(parent, active))
        if self.nodes[number]["type"] == "loop" and info["backingFile"] is None:
            fail("AMBIGUOUS_TOPOLOGY", "Loop backing metadata is missing.")
        if info["backingFile"] is not None:
            path = info["backingFile"]
            if not path.startswith("/") or path.endswith(" (deleted)"):
                fail("AMBIGUOUS_TOPOLOGY", "Loop backing file cannot be resolved.")
            backing_number = device_number(self.system.loop_backing(number, self.nodes[number]["name"]))
            candidates = [m for m in self.mounts if m.number == backing_number]
            if not candidates:
                fail("AMBIGUOUS_TOPOLOGY", "Loop backing filesystem is not mounted in this namespace.")
            backing = set()
            # Resolve every visible mount of the authoritative superblock; never
            # trust the stale filename, a guessed replacement, or a FUSE export.
            for mount in candidates:
                backing.update(self.backing_mount(mount, active))
            if not backing:
                fail("AMBIGUOUS_TOPOLOGY", "Loop backing storage is ambiguous.")
            result.update(backing)
        return result

    def backing_path(self, path, active):
        number = self.system.path_identity(path)
        if number in self.nodes:
            return self.ancestors(number, active)
        candidates = [m for m in self.mounts
                      if path == m.target or path.startswith(m.target.rstrip("/") + "/")]
        if not candidates:
            fail("AMBIGUOUS_TOPOLOGY", "Backing file has no known mount.")
        return self.backing_mount(max(candidates, key=lambda m: len(m.target)), active)

    def backing_mount(self, mount, active=frozenset(), *, allow_portal=False):
        key = ("mount", mount.target)
        if key in active or len(active) > 64:
            fail("AMBIGUOUS_TOPOLOGY", "Cyclic mount ancestry.")
        active = active | {key}
        # mountinfo/lsblk do not enumerate every member of multi-device Btrfs.
        # Until membership is independently verified, even a single reported
        # source cannot authorize erasing any disk in this mount namespace.
        if mount.filesystem == "btrfs":
            fail("AMBIGUOUS_TOPOLOGY", "Mounted Btrfs membership requires additional validation.")
        if mount.number in self.nodes:
            return self.ancestors(mount.number, active)
        if mount.source.startswith("/dev/"):
            return self.ancestors(self.system.path_identity(mount.source, block=True), active)
        if mount.filesystem == "overlay":
            options = dict(item.split("=", 1) for item in mount.options.split(",") if "=" in item)
            if "lowerdir" not in options:
                fail("AMBIGUOUS_TOPOLOGY", "Overlay backing directories are missing.")
            result = set()
            for option in ("lowerdir", "upperdir", "workdir"):
                for path in options.get(option, "").split(":"):
                    if not path and option != "lowerdir":
                        continue
                    # Escaped delimiters and overlay data-only layers are not supported.
                    if not path.startswith("/") or "\\" in path:
                        fail("AMBIGUOUS_TOPOLOGY", "Overlay backing path is ambiguous.")
                    result.update(self.backing_path(path, active))
            return result
        if mount.filesystem in PSEUDO_FILESYSTEMS and mount.number.startswith("0:"):
            return set()
        # Document portal is an exported-file namespace, not a block-backed
        # filesystem. All real mounts are still independently protected. Permit
        # only its usual standalone user mount, never as loop/overlay backing.
        if (allow_portal and mount.filesystem == "fuse.portal" and mount.source == "portal"
                and mount.number.startswith("0:")
                and re.fullmatch(r"/run/user/[0-9]+/doc", mount.target)):
            return set()
        fail("AMBIGUOUS_TOPOLOGY", "Mounted filesystem backing storage is unknown.")

    def protected_devices(self):
        protected = set()
        for mount in self.mounts:
            backing = self.backing_mount(mount, allow_portal=True)
            if mount.target == "/" and not backing:
                fail("AMBIGUOUS_TOPOLOGY", "Root backing storage is unresolved.")
            protected.update(backing)
        swaps = self.system.swaps().splitlines()
        if not swaps or not swaps[0].startswith("Filename"):
            fail("AMBIGUOUS_TOPOLOGY", "Swap topology is unreadable.")
        for line in swaps[1:]:
            fields = line.split()
            if len(fields) != 5 or fields[1] not in {"partition", "file"}:
                fail("AMBIGUOUS_TOPOLOGY", "Swap topology is ambiguous.")
            path = mount_unescape(fields[0])
            if fields[1] == "partition":
                protected.update(self.ancestors(self.system.path_identity(path, block=True)))
            else:
                protected.update(self.backing_path(path, frozenset()))
        return protected

    def validate(self, path):
        number = self.system.path_identity(path, block=True)
        node = self.nodes.get(number)
        if node is None:
            fail("AMBIGUOUS_TOPOLOGY", "Selected device is absent from block topology.")
        info = self.system.sysfs(number)
        if (node["name"] != path or node["type"] != "disk" or info["partition"]
                or info["parents"] or info["backingFile"] is not None
                or node["ro"] or node["rm"]):
            fail("UNSAFE_DEVICE", "Target must be an inactive non-removable whole disk.")
        self.ancestors(number)
        if not positive_integer(info["size"]) or not positive_integer(info["diskSequence"]):
            fail("AMBIGUOUS_TOPOLOGY", "Target size or disk sequence is unavailable.")
        if number in self.protected_devices():
            fail("UNSAFE_DEVICE", "Target backs a mounted filesystem or active swap.")
        for other, child in self.nodes.items():
            if other != number and number in self.ancestors(other) and child["type"] != "part":
                fail("UNSAFE_DEVICE", "Nested target storage is unsupported.")
        return Device(path, number, info["size"], info["diskSequence"], info["path"])


def validate_device(system, path):
    # Only absence of the requested /dev node is DEVICE_NOT_FOUND. Missing
    # sysfs, overlay paths or unrelated backing storage is ambiguous topology.
    try:
        system.path_identity(path, block=True)
    except FileNotFoundError:
        fail("DEVICE_NOT_FOUND", "Selected device is absent.")
    except OSError:
        fail("AMBIGUOUS_TOPOLOGY", "Selected device identity could not be read.")
    try:
        return Topology(system).validate(path)
    except FileNotFoundError:
        fail("AMBIGUOUS_TOPOLOGY", "Required topology data disappeared.")
    except (OSError, ValueError, KeyError, TypeError, RecursionError):
        fail("AMBIGUOUS_TOPOLOGY", "Device topology could not be validated.")


class InstallerLock:
    """Persistent inode under a root-owned /run directory; never unlink a lock."""

    def __init__(self, directory=LOCK_DIRECTORY, owner_uid=0):
        self.directory = directory
        self.owner_uid = owner_uid
        self.fd = None

    def trusted(self, fd, directory=False):
        info = os.fstat(fd)
        expected_type = stat.S_ISDIR if directory else stat.S_ISREG
        if (info.st_uid != self.owner_uid or not expected_type(info.st_mode)
                or stat.S_IMODE(info.st_mode) != (0o700 if directory else 0o600)
                or not directory and info.st_nlink != 1):
            fail("UNSAFE_LOCK", "Installer lock ownership or permissions are unsafe.")

    def __enter__(self):
        parent = child = None
        try:
            parent_path, name = os.path.split(self.directory)
            parent = os.open(parent_path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
            info = os.fstat(parent)
            if info.st_uid != self.owner_uid or stat.S_IMODE(info.st_mode) & 0o022:
                fail("UNSAFE_LOCK", "Installer runtime directory is unsafe.")
            try:
                os.mkdir(name, 0o700, dir_fd=parent)
            except FileExistsError:
                pass
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
            self.trusted(child, directory=True)
            self.fd = os.open("install.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC,
                              0o600, dir_fd=child)
            self.trusted(self.fd)
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                fail("BUSY", "Another privileged installation operation holds the lock.")
            return self
        except BaseException:
            if self.fd is not None:
                os.close(self.fd)
                self.fd = None
            raise
        finally:
            for fd in (child, parent):
                if fd is not None:
                    os.close(fd)

    def __exit__(self, *_):
        os.close(self.fd)
        self.fd = None


def safe_session_report(value):
    try:
        loader=importlib.machinery.SourceFileLoader('ro_helper_records',str(Path(__file__).with_name('ro_installer_records.py')))
        spec=importlib.util.spec_from_loader(loader.name,loader)
        module=importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return value if module.valid_report(value) else None
    except Exception:
        return None


def backend_message(raw, *, allow_report=False, allow_copy=False, confirmed_plan=None):
    try:
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object,
                           parse_constant=lambda _: fail("BACKEND_ERROR", "Invalid backend number."))
        if not isinstance(value, dict) or type(value.get("protocolVersion")) is not int or value["protocolVersion"] != 1:
            raise ValueError()
        kind = value.get("type")
        if kind == "session-report" and allow_report:
            if set(value) != {'protocolVersion','type','report'}:
                raise ValueError()
            return value
        if kind == "copy-progress" and allow_copy:
            integer=lambda n,limit: type(n) is int and 0 <= n <= limit
            if (set(value) != {'protocolVersion','type','phase','bytesProcessed','bytesPerSecond','etaSeconds'}
                    or value['phase'] not in ('main','efi')
                    or not integer(value['bytesProcessed'],9007199254740991)
                    or value['bytesPerSecond'] is not None and not integer(value['bytesPerSecond'],9007199254740991)
                    or value['etaSeconds'] is not None and (not integer(value['etaSeconds'],86400) or not value['bytesPerSecond'])):
                raise ValueError()
        elif kind == "progress":
            if (set(value) != {"protocolVersion", "type", "stage", "progress", "messageKey"}
                    or type(value["stage"]) is not int or not 0 <= value["stage"] <= 9
                    or type(value["progress"]) not in (int, float) or not 0 <= value["progress"] <= 1
                    or value["messageKey"] != STAGE_KEYS[value["stage"]]):
                raise ValueError()
        elif kind == "ready":
            if (set(value) != ({'protocolVersion','type'} if confirmed_plan is None else {'protocolVersion','type','confirmedPlan'})
                    or confirmed_plan is not None and not same_plan_value(value['confirmedPlan'],confirmed_plan)):
                raise ValueError()
        elif kind == "result":
            if (set(value) != {"protocolVersion", "type", "ok", "code"}
                    or type(value["ok"]) is not bool
                    or value["code"] not in {"OK", "INSTALL_FAILED", "BACKEND_ERROR"}
                    or value["ok"] != (value["code"] == "OK")):
                raise ValueError()
        else:
            raise ValueError()
        return value
    except (ValueError, UnicodeError, RecursionError, KeyError, TypeError, HelperError):
        fail("BACKEND_ERROR", "Invalid backend protocol message.")


def stop_backend_group(process):
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def run_backend(request, confirmed, system, emit, *, lock_fd=None):
    # The backend is compiled from the existing Dart engine, in this same RPM.
    # No caller executable, argv, environment or engine configuration is used.
    # Inherit the locked descriptor: the kernel lease survives helper SIGKILL
    # until the independent backend (and its synchronous children) exits.
    reports = request.protocol_version == 2
    child_env = dict(CHILD_ENV, RO_INSTALLER_SESSION_REPORT='2') if reports else CHILD_ENV
    payload={"protocolVersion":1,"operation":request.operation,"disk":confirmed.path,"expectedDevice":request.expected_device}
    if request.ui_language is not None:payload['uiLanguage']=request.ui_language
    if request.include_copy_progress:payload['includeCopyProgress']=True
    if request.confirmed_plan is not None:payload['confirmedPlan']=request.confirmed_plan
    if request.source_snapshot is not None:payload['sourceSnapshot']=request.source_snapshot
    encoded=json.dumps(payload,separators=(',',':')).encode()+b'\n'
    if len(encoded)>MAX_MESSAGE_BYTES:fail('INVALID_REQUEST','Approved backend plan exceeds the message limit.')
    try:
        process = subprocess.Popen(BACKEND_ARGV, stdin=subprocess.PIPE,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   env=child_env, close_fds=True, start_new_session=True,
                                   pass_fds=() if lock_fd is None else (lock_fd,))
    except OSError:
        fail("BACKEND_ERROR", "Privileged backend could not start.")
    authorized = False
    report_seen = False
    report_status = "unavailable"
    report = None
    final = None
    copy_phase = None
    copy_bytes = 0
    current_stage = 0
    failure = None
    streams = [process.stdout, process.stderr]
    pending = bytearray()
    total = stderr_bytes = messages = 0
    deadline = time.monotonic() + BACKEND_TIMEOUT
    try:
        process.stdin.write(encoded)
        process.stdin.flush()
        while streams:
            remaining = deadline - time.monotonic()
            ready = select.select(streams, [], [], max(0, min(remaining, 1)))[0]
            if remaining <= 0:
                failure = HelperError("BACKEND_ERROR", "Privileged backend exceeded the installation deadline.")
                break
            for stream in ready:
                chunk = os.read(stream.fileno(), 4096)
                if not chunk:
                    streams.remove(stream)
                    continue
                if stream is process.stderr:
                    stderr_bytes += len(chunk)
                    if stderr_bytes > 65536 and failure is None:
                        failure = HelperError("BACKEND_ERROR", "Backend diagnostics exceeded the safety limit.")
                    continue
                total += len(chunk)
                if total > MAX_BACKEND_BYTES and failure is None:
                    failure = HelperError("BACKEND_ERROR", "Backend stream exceeded the safety limit.")
                if failure is not None:
                    continue
                pending.extend(chunk)
                try:
                    while b"\n" in pending:
                        raw, _, rest = pending.partition(b"\n")
                        pending = bytearray(rest)
                        messages += 1
                        if len(raw) > MAX_MESSAGE_BYTES or messages > 16384 or report_seen:
                            fail("BACKEND_ERROR", "Invalid backend stream framing.")
                        message = backend_message(raw, allow_report=reports, allow_copy=request.include_copy_progress,confirmed_plan=request.confirmed_plan)
                        if message['type'] == 'session-report':
                            report_seen = True
                            report = safe_session_report(message['report'])
                            report_status = 'available' if report is not None else 'invalid'
                            continue
                        if final is not None:
                            fail('BACKEND_ERROR','Unexpected message after terminal result.')
                        if message["type"] == "ready":
                            if authorized:
                                fail("BACKEND_ERROR", "Repeated backend mutation gate.")
                            # This handshake is inside PartitioningStage after its
                            # read-only checks, immediately before the first wipefs.
                            if validate_device(system, request.disk) != confirmed:
                                fail("DEVICE_CHANGED", "Device changed immediately before mutation.")
                            if request.operation=='install-manual':
                                approval=request.confirmed_plan;intent=approval['intent']
                                verified=system.gpt_snapshot(confirmed,manual_roles=request.manual_choices,admit_manual=True)
                                slots=[intent[role]['number'] for role in ('esp','root') if intent[role]['source']=='create']
                                fresh=system.gpt_snapshot(confirmed,layout_slots=slots)
                                if (not same_plan_value(verified['snapshot'],request.source_snapshot)
                                        or not same_plan_value(verified['plan'],intent)
                                        or not same_plan_value(fresh['snapshot'],request.source_snapshot)
                                        or fresh['preservationFingerprint']!=approval['preservationFingerprint']):
                                    fail('DEVICE_CHANGED','Manual plan changed before mutation.')
                            elif request.operation=='install-free-space':
                                approval=request.confirmed_plan;intent=approval['intent'];slots=[intent['esp']['number'],intent['root']['number']]
                                fresh=system.gpt_snapshot(confirmed,preserve_slots=slots)
                                if (fresh['snapshot']['tableFingerprint']!=request.source_snapshot['tableFingerprint']
                                        or fresh['preservationFingerprint']!=approval['preservationFingerprint']
                                        or not same_plan_value(gpt_module().compact_plan(fresh['snapshot'],intent['selectedExtent']),intent)):
                                    fail('DEVICE_CHANGED','Free-space plan changed before mutation.')
                            gate = {"protocolVersion": 1, "type": "continue", "device": confirmed.public()}
                            if request.confirmed_plan is not None:
                                gate['confirmedPlan']=request.confirmed_plan
                            process.stdin.write(json.dumps(gate).encode() + b"\n")
                            process.stdin.flush()
                            process.stdin.close()
                            authorized = True
                        elif message["type"] == "result":
                            final = message
                        else:
                            if message['type'] == 'progress':
                                current_stage = message['stage']
                            elif message['type'] == 'copy-progress':
                                if (not authorized or current_stage != 5
                                        or copy_phase == 'efi' and message['phase'] == 'main'
                                        or copy_phase == message['phase'] and message['bytesProcessed'] < copy_bytes):
                                    fail('BACKEND_ERROR','Out-of-order copy progress.')
                                copy_phase,copy_bytes = message['phase'],message['bytesProcessed']
                            emit(message)
                    if len(pending) > MAX_MESSAGE_BYTES:
                        fail("BACKEND_ERROR", "Backend message exceeded the safety limit.")
                except HelperError as error:
                    failure = error
            # Before authorization, aborting cannot interrupt a disk mutation.
            # Afterwards a malformed/closed GUI stream is never cancellation:
            # drain without forwarding and retain the lock until engine exit.
            if failure is not None and not authorized:
                break
        if failure is not None and not authorized or time.monotonic() >= deadline:
            stop_backend_group(process)
        status = process.wait(timeout=max(1, deadline - time.monotonic()))
        if failure is not None:
            raise failure
        if pending or final is None or (final["ok"] and (not authorized or status != 0)):
            fail("BACKEND_ERROR", "Backend ended without a valid successful result.")
        if not final["ok"]:
            fail(final["code"], "Privileged installation failed; inspect the installed-target state before retrying.")
        return {"installed": True}
    except (OSError, subprocess.TimeoutExpired):
        fail("BACKEND_ERROR", "Privileged backend transport failed.")
    finally:
        # A crashed engine must not leave a formatting/copy grandchild running
        # after the installation lock is released. Success has no live children.
        stop_backend_group(process)
        process.wait()
        for stream in (process.stdin, process.stdout, process.stderr):
            if not stream.closed:
                stream.close()
        if reports:
            emit({'protocolVersion':1,'type':'session-report','status':report_status,'report':report})


def handle(request, system, emit=lambda _: None):
    if os.geteuid() != 0:
        fail("ROOT_REQUIRED", "The helper requires effective UID zero.")
    if request.operation == "audit-live":
        return {"audit": system.audit()}
    if request.operation == "probe-disk":
        return {"device": validate_device(system, request.disk).public()}
    if request.operation in V2_READ_OPERATIONS:
        if request.protocol_version!=2:fail('INVALID_REQUEST','GPT planning requires helper v2.')
        if not system.platform_supported():fail('UNSUPPORTED_PLATFORM','GPT planning requires x86_64 UEFI.')
        with InstallerLock() as lock:
            system.lease_fd=lock.fd
            try:
                before=validate_device(system,request.disk)
                if request.expected_device is not None and before.public()!={'path':request.disk,**request.expected_device}:
                    fail('DEVICE_CHANGED','Target no longer matches the selected device.')
                snapshot=system.gpt_snapshot(before)
                if validate_device(system,request.disk)!=before:fail('DEVICE_CHANGED','Device changed during GPT planning.')
                try:snapshot=gpt_module().normalize_snapshot(snapshot,before.public())
                except (ValueError,TypeError,KeyError):fail('AMBIGUOUS_TOPOLOGY','Invalid GPT snapshot.')
                if request.operation=='probe-free-space':return {'snapshot':snapshot}
                if snapshot['tableFingerprint']!=request.table_fingerprint:fail('DEVICE_CHANGED','Partition table changed since selection.')
                if request.operation in ('assess-ntfs-shrink','prepare-ntfs-shrink'):
                    proposal = {'schemaVersion': 1, 'snapshot': snapshot, **request.ntfs_choices}
                    try:
                        # Structural rejection before expensive filesystem inspection.
                        preliminary = gpt_module().ntfs_shrink_plan({**proposal, 'minimumFilesystemBytes': 1})
                    except (ValueError, TypeError, KeyError):
                        fail('INVALID_REQUEST', 'Unsupported NTFS shrink geometry.')
                    preparation = None
                    if request.operation == 'prepare-ntfs-shrink':
                        preparation = system.prepare_ntfs(snapshot, preliminary['source'],
                            preliminary['source']['retainedBytes'], request.inspection_fingerprint)
                        try:
                            preparation = normalize_ntfs_preparation(preparation, snapshot, preliminary['source'],
                                preliminary['source']['retainedBytes'], request.inspection_fingerprint)
                        except (ValueError,TypeError,KeyError):fail('AMBIGUOUS_TOPOLOGY','Invalid NTFS target preparation evidence.')
                        inspection = preparation['inspection']
                    else: inspection = system.inspect_ntfs(snapshot, preliminary['source'])
                    try:
                        inspection = normalize_ntfs_inspection(inspection, snapshot, preliminary['source'])
                        computed = gpt_module().ntfs_shrink_plan({**proposal, 'minimumFilesystemBytes': inspection['minimumBytes']})
                    except (ValueError, TypeError, KeyError):
                        fail('AMBIGUOUS_TOPOLOGY', 'NTFS source has insufficient verified capacity.')
                    fresh = system.gpt_snapshot(before)
                    if not same_plan_value(snapshot, fresh) or validate_device(system, request.disk) != before:
                        fail('DEVICE_CHANGED', 'Device changed during NTFS assessment.')
                    if preparation is not None:
                        try:return normalize_ntfs_prepared_plan({'plan':computed,'inspection':inspection,
                            'preparation':preparation['preparation']}, proposal, request.inspection_fingerprint)
                        except (ValueError,TypeError,KeyError):fail('AMBIGUOUS_TOPOLOGY','Invalid prepared NTFS plan.')
                    return {'plan': computed, 'inspection': inspection}
                if request.operation == 'validate-manual-plan':
                    try:gpt_module().manual_plan(snapshot,request.manual_choices)
                    except (ValueError,TypeError,KeyError):fail('INVALID_REQUEST','Invalid manual allocation.')
                    verified=system.gpt_snapshot(before,manual_roles=request.manual_choices)
                    if not same_plan_value(snapshot,verified['snapshot']) or validate_device(system,request.disk)!=before:
                        fail('DEVICE_CHANGED','Device changed during manual validation.')
                    computed=gpt_module().manual_plan(snapshot,request.manual_choices)
                    if not same_plan_value(computed,verified['plan']):fail('AMBIGUOUS_TOPOLOGY','Manual probe mismatch.')
                    return {'plan':computed}
                try:return {'plan':gpt_module().compact_plan(snapshot,request.selected_extent)}
                except (ValueError,TypeError,KeyError):fail('INVALID_REQUEST','Selected free-space plan is no longer valid.')
            finally:del system.lease_fd
    if request.operation=='install-manual':
        if request.protocol_version!=2:fail('INVALID_REQUEST','Manual installation requires helper v2.')
        if not system.platform_supported():fail('UNSUPPORTED_PLATFORM','Installation requires x86_64 UEFI.')
        with InstallerLock() as lock:
            system.lease_fd=lock.fd
            try:
                before=validate_device(system,request.disk)
                if before.public()!={'path':request.disk,**request.expected_device}:fail('DEVICE_CHANGED','Selected device changed.')
                verified=system.gpt_snapshot(before,manual_roles=request.manual_choices,admit_manual=True)
                initial=verified['snapshot'];intent=verified['plan']
                if not same_plan_value(intent,request.confirmed_plan):fail('DEVICE_CHANGED','Manual plan changed since confirmation.')
                slots=[intent[role]['number'] for role in ('esp','root') if intent[role]['source']=='create']
                proof=system.gpt_snapshot(before,layout_slots=slots)
                if not same_plan_value(initial,proof['snapshot']):fail('DEVICE_CHANGED','GPT changed during manual admission.')
                used={p['partitionGuid'] for p in initial['partitions']}|{initial['diskGuid']};ids={}
                for role in ('esp','root'):
                    if intent[role]['source']=='create':
                        value=str(uuid.uuid4())
                        if value in used:fail('SYSTEM_ERROR','Partition identity allocation failed.')
                        ids[role]=value;used.add(value)
                approval={'intent':intent,'allocationGuids':ids,'preservationFingerprint':proof['preservationFingerprint']}
                effective=dataclasses.replace(request,confirmed_plan=approval,source_snapshot=initial)
                if validate_device(system,request.disk)!=before:fail('DEVICE_CHANGED','Device changed during manual admission.')
                return run_backend(effective,before,system,emit,lock_fd=lock.fd)
            finally:del system.lease_fd
    if request.operation=='install-free-space':
        if request.protocol_version!=2:fail('INVALID_REQUEST','Free-space installation requires helper v2.')
        if not system.platform_supported():fail('UNSUPPORTED_PLATFORM','Free-space installation requires x86_64 UEFI.')
        with InstallerLock() as lock:
            system.lease_fd=lock.fd
            try:
                before=validate_device(system,request.disk)
                if before.public()!={'path':request.disk,**request.expected_device}:fail('DEVICE_CHANGED','Selected device changed.')
                initial=system.gpt_snapshot(before);intent=request.confirmed_plan
                try:computed=gpt_module().compact_plan(initial,intent['selectedExtent'])
                except (ValueError,KeyError,TypeError):fail('INVALID_REQUEST','Invalid free-space allocation.')
                if not same_plan_value(computed,intent):fail('DEVICE_CHANGED','Selected partition table changed.')
                if len(initial['partitions'])>30:fail('INVALID_REQUEST','Free-space installation exceeds the verified inventory limit.')
                proof=system.gpt_snapshot(before,preserve_slots=[intent['esp']['number'],intent['root']['number']])
                if proof['snapshot']['tableFingerprint']!=initial['tableFingerprint']:fail('DEVICE_CHANGED','GPT changed during admission.')
                used={p['partitionGuid'] for p in initial['partitions']}|{initial['diskGuid']}
                ids={}
                for role in ('esp','root'):
                    value=str(uuid.uuid4())
                    if value in used:fail('SYSTEM_ERROR','Partition identity allocation failed.')
                    ids[role]=value;used.add(value)
                approved={'intent':computed,'allocationGuids':ids,'preservationFingerprint':proof['preservationFingerprint']}
                effective=dataclasses.replace(request,confirmed_plan=approved,source_snapshot=proof['snapshot'])
                if validate_device(system,request.disk)!=before:fail('DEVICE_CHANGED','Device changed during admission.')
                return run_backend(effective,before,system,emit,lock_fd=lock.fd)
            finally:del system.lease_fd
    if request.operation != "install-full-disk":
        fail("INVALID_REQUEST", "Unsupported operation.")
    if not system.platform_supported():
        fail("UNSUPPORTED_PLATFORM", "Installation requires x86_64 UEFI.")
    with InstallerLock() as lock:
        before = validate_device(system, request.disk)
        expected = {key: value for key, value in before.public().items() if key != "path"}
        if expected != request.expected_device:
            fail("DEVICE_CHANGED", "Target no longer matches the confirmed device identity.")
        # Validate again before spawning the fixed engine. The ready/continue
        # handshake performs one more gate immediately before its first mutation.
        after = validate_device(system, request.disk)
        if before != after:
            fail("DEVICE_CHANGED", "Target identity changed before installation.")
        return run_backend(request, after, system, emit, lock_fd=lock.fd)


def emit_message(message, version, fd):
    """Bounded nonblocking public output; a lost GUI never cancels mutation."""
    try:
        raw=json.dumps(dict(message,protocolVersion=version),separators=(',',':')).encode()+b'\n'
        if len(raw)>MAX_MESSAGE_BYTES:return False
        os.set_blocking(fd,False)
        while raw:
            count=os.write(fd,raw)
            if count<=0:return False
            raw=raw[count:]
        return True
    except (OSError,ValueError):
        return False


def main():
    sys.dont_write_bytecode=True
    # The isolated shebang ignores Python import/environment injection before this.
    os.environ.clear()
    os.environ.update(CHILD_ENV)
    os.umask(0o077)
    operation = None
    version = 1
    output_available = True
    try:
        os.chdir("/")
        if sys.argv[1:] not in ([], ["--protocol=1"], ["--protocol=2"]):
            fail("INVALID_REQUEST", "Unsupported explicit helper protocol.")
        version = 2 if sys.argv[1:] == ['--protocol=2'] else 1
        request = parse_request(read_request(sys.stdin.fileno()), version=version)
        operation = request.operation
        def emit(message):
            nonlocal output_available
            if output_available:
                output_available=emit_message(message,version,sys.stdout.fileno())
        if request.operation == 'prepare-ntfs-shrink':
            def interrupt(*_):raise KeyboardInterrupt()
            for sig in (signal.SIGINT,signal.SIGTERM,signal.SIGHUP):signal.signal(sig,interrupt)
        if request.operation in ('install-full-disk','install-free-space','install-manual'):
            for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                signal.signal(sig, signal.SIG_IGN)
        result = handle(request, System(), emit)
        output = {"protocolVersion": 1, "operation": operation, "ok": True, **result}
        status = 0
    except HelperError as error:
        output = {"protocolVersion": 1, "operation": operation, "ok": False,
                  "error": {"code": error.code, "message": error.message}}
        status = EXIT_CODES[error.code]
    except (Exception, KeyboardInterrupt):
        # Constant diagnostics only: no attacker-controlled JSON/tool output,
        # environment values, secrets or tracebacks on either protocol channel.
        output = {"protocolVersion": 1, "operation": operation, "ok": False,
                  "error": {"code": "SYSTEM_ERROR", "message": "Helper operation failed safely."}}
        status = 7
    output["protocolVersion"] = version
    output["type"] = "result"
    if output_available:
        emit_message(output,version,sys.stdout.fileno())
    return status


if __name__ == "__main__":
    sys.exit(main())
