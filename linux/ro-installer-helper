def full_disk_plan(device):
    disk=device['path']
    partition=lambda n: disk+('p' if any(word in disk for word in ('nvme','loop','mmcblk')) else '')+str(n)
    operations=[{'type':kind,'target':target,'destructive':True} for kind,target in (
        ('wipe_disk',disk),('create_efi',disk),('create_btrfs_root',disk),
        ('format_efi',partition(1)),('format_btrfs_root',partition(2)))]
    return {'schemaVersion':1,'layoutVersion':1,'device':dict(device),'partitionTable':'gpt',
            'espBytes':512*1024*1024,'espFileSystem':'fat32','diskSwap':False,
            'subvolumes':{'root':'/','home':'/home','var_log':'/var/log','var_cache':'/var/cache','var_tmp':'/var/tmp'},
            'storagePlan':{'planId':'full-'+re.sub(r'[^A-Za-z0-9._-]','_',disk),
                           'mode':'full','targetDisk':disk,'fileSystem':'btrfs',
                           'operations':operations,'destructiveOperations':operations}}


def same_plan_value(actual, expected):
    return json.dumps(actual,sort_keys=True,separators=(',',':')) == json.dumps(expected,sort_keys=True,separators=(',',':'))


def parse_request(raw, version=1):
    if len(raw) > MAX_REQUEST_BYTES:
        fail("REQUEST_TOO_LARGE", "Request exceeds the protocol size limit.")
    try:
        data = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object,
                          parse_constant=lambda _: fail("INVALID_REQUEST", "Invalid JSON number."))
    except (UnicodeError, ValueError, RecursionError):
        fail("INVALID_REQUEST", "Request must be one UTF-8 JSON object.")
    if not isinstance(data, dict):
        fail("INVALID_REQUEST", "Request must be one JSON object.")
    if type(data.get("protocolVersion")) is not int or data["protocolVersion"] != version:
        fail("INVALID_REQUEST", "Unsupported protocol version.")
    operation = data.get("operation")
    if not isinstance(operation, str) or operation not in (OPERATIONS | V2_READ_OPERATIONS | V2_INSTALL_OPERATIONS if version == 2 else OPERATIONS):
        fail("INVALID_REQUEST", "Unsupported operation.")
    allowed = {"protocolVersion", "operation"}
    if operation != "audit-live":
        allowed.add("disk")
    if operation == 'validate-free-space-plan':
        allowed.update({'expectedDevice','tableFingerprint','selectedExtent'})
    if operation == 'validate-manual-plan':
        allowed.update({'expectedDevice','tableFingerprint','esp','root'})
    if operation in ('assess-ntfs-shrink','prepare-ntfs-shrink'):
        allowed.update({'expectedDevice','tableFingerprint','sourceNumber','espNumber','rootBytes'})
    if operation == 'prepare-ntfs-shrink':allowed.add('inspectionFingerprint')
    if operation in ('install-full-disk','install-free-space','install-manual'):
        allowed.update({"confirmDestructive", "expectedDevice"})
        if operation=='install-full-disk':allowed.update({'partitionMethod','fileSystem'})
        else:allowed.add('confirmedPlan')
        if version == 2 and 'confirmedPlan' in data:
            allowed.add('confirmedPlan')
        if version == 2 and "includeCopyProgress" in data:
            allowed.add("includeCopyProgress")
            if data["includeCopyProgress"] is not True:
                fail("INVALID_REQUEST", "Copy progress requires explicit opt-in.")
        if version == 2 and "uiLanguage" in data:
            allowed.add("uiLanguage")
            if (not isinstance(data["uiLanguage"], str)
                    or data["uiLanguage"] not in INSTALLER_UI_LANGUAGES):
                fail("INVALID_REQUEST", "Unsupported installer UI language hint.")
    if set(data) != allowed:
        fail("INVALID_REQUEST", "Missing or unknown request fields.")
    if operation == "audit-live":
        return Request(operation, protocol_version=version)
    disk = data["disk"]
    # Canonical /dev names only. The authoritative checks below use stat/sysfs.
    if not isinstance(disk, str) or not re.fullmatch(r"/dev/[A-Za-z0-9_-]{1,128}", disk):
        fail("INVALID_REQUEST", "A canonical whole-disk /dev path is required.")
    expected = None
    if operation == "install-full-disk":
        if (data["partitionMethod"] != "full" or data["fileSystem"] != "btrfs"
                or data["confirmDestructive"] is not True):
            fail("INVALID_REQUEST", "Only explicitly confirmed full/Btrfs installation is supported.")
    if operation in ('install-full-disk','install-free-space','install-manual','validate-free-space-plan','validate-manual-plan','assess-ntfs-shrink','prepare-ntfs-shrink'):
        expected = data["expectedDevice"]
        if (not isinstance(expected, dict)
                or set(expected) != {"majorMinor", "size", "diskSequence"}
                or not positive_integer(expected["size"])
                or not positive_integer(expected["diskSequence"])):
            fail("INVALID_REQUEST", "A complete expected device identity is required.")
        try:
            number = device_number(expected["majorMinor"])
        except HelperError:
            fail("INVALID_REQUEST", "Invalid expected device identity.")
        expected = dict(expected, majorMinor=number)
    plan = None
    choices = None
    if operation=='install-free-space':
        if data['confirmDestructive'] is not True:fail('INVALID_REQUEST','Explicit free-space confirmation required.')
        plan=data['confirmedPlan']
        try:
            if (not isinstance(plan,dict) or set(plan)!={'schemaVersion','mode','device','tableFingerprint','selectedExtent','fileSystem','diskSwap','esp','root'}
                    or type(plan['schemaVersion']) is not int or plan['schemaVersion']!=1 or plan['mode']!='free_space'
                    or plan['fileSystem']!='btrfs' or plan['diskSwap'] is not False
                    or not same_plan_value(plan['device'],{'path':disk,**expected})
                    or not isinstance(plan['tableFingerprint'],str) or not re.fullmatch('[0-9a-f]{64}',plan['tableFingerprint'])
                    or not isinstance(plan['selectedExtent'],dict) or set(plan['selectedExtent'])!={'startSector','endSector'}):raise ValueError()
            for key in ('esp','root'):
                row=plan[key]
                if not isinstance(row,dict) or set(row)!={'number','startSector','endSector'}:raise ValueError()
                if type(row['number']) is not int or not 1<=row['number']<=4096:raise ValueError()
                if type(row['startSector']) is not int or type(row['endSector']) is not int or not 0<=row['startSector']<=row['endSector']<=9007199254740991:raise ValueError()
            extent=plan['selectedExtent']
            if type(extent['startSector']) is not int or type(extent['endSector']) is not int or not 0<=extent['startSector']<=extent['endSector']<=9007199254740991:raise ValueError()
        except (ValueError,TypeError,KeyError):fail('INVALID_REQUEST','Invalid compact free-space plan.')
    elif operation=='install-manual':
        if data['confirmDestructive'] is not True:fail('INVALID_REQUEST','Explicit manual confirmation required.')
        plan=data['confirmedPlan']
        try:choices=gpt_module().manual_intent_choices(plan,{'path':disk,**expected})
        except (ValueError,TypeError,KeyError):fail('INVALID_REQUEST','Invalid compact manual plan.')
    elif 'confirmedPlan' in data:
        plan=full_disk_plan({'path':disk,**expected})
        if not same_plan_value(data['confirmedPlan'],plan):
            fail('INVALID_REQUEST','Confirmed plan does not match the fixed full-disk contract.')
    fingerprint=extent=None
    if operation == 'validate-free-space-plan':
        fingerprint=data['tableFingerprint'];extent=data['selectedExtent']
        if (not isinstance(fingerprint,str) or not re.fullmatch('[0-9a-f]{64}',fingerprint)
                or not isinstance(extent,dict) or set(extent)!={'startSector','endSector'}
                or type(extent['startSector']) is not int or type(extent['endSector']) is not int
                or not 0<=extent['startSector']<=extent['endSector']<=9007199254740991):
            fail('INVALID_REQUEST','Invalid free-space intent.')
    if operation == 'validate-manual-plan':
        fingerprint = data['tableFingerprint']
        if not isinstance(fingerprint, str) or not re.fullmatch('[0-9a-f]{64}', fingerprint):
            fail('INVALID_REQUEST', 'Invalid source fingerprint.')
        try:
            choices = {role: gpt_module().manual_choice(data[role]) for role in ('esp', 'root')}
            if choices['root'].get('formatOnInstall', True) is not True:
                raise ValueError()
        except (ValueError, TypeError, KeyError):
            fail('INVALID_REQUEST', 'Invalid manual role choices.')
    ntfs_choices = observed_fingerprint = None
    if operation in ('assess-ntfs-shrink','prepare-ntfs-shrink'):
        fingerprint = data['tableFingerprint']
        if not isinstance(fingerprint, str) or not re.fullmatch('[0-9a-f]{64}', fingerprint):
            fail('INVALID_REQUEST', 'Invalid source fingerprint.')
        try:
            ntfs_choices = {
                'sourceNumber': gpt_module().integer(data['sourceNumber'], 1, 4096),
                'espNumber': gpt_module().integer(data['espNumber'], 1, 4096),
                'rootBytes': gpt_module().integer(data['rootBytes'], 40 * 1024**3, 9007199254740991),
            }
        except (ValueError, TypeError, KeyError):
            fail('INVALID_REQUEST', 'Invalid NTFS geometry selection.')
    if operation == 'prepare-ntfs-shrink':
        observed_fingerprint = data['inspectionFingerprint']
        if not isinstance(observed_fingerprint, str) or not re.fullmatch('[0-9a-f]{64}', observed_fingerprint):
            fail('INVALID_REQUEST','Invalid NTFS inspection fingerprint.')
    return Request(operation, disk, expected, version, data.get("uiLanguage"), data.get("includeCopyProgress", False), plan, fingerprint, extent, manual_choices=choices, ntfs_choices=ntfs_choices, inspection_fingerprint=observed_fingerprint)


