import struct
import subprocess
import sys
import tempfile
import threading

HELPER = '/usr/libexec/ro-installer-helper'
BACKEND = ('/usr/libexec/ro-installer-backend', '--privileged-backend-v1')
AUTO = ('/usr/bin/ro-installer',)
SESSION_ENV = 'RO_INSTALLER_SESSION_SOCKET'
ROOT_ENV = {'PATH':'/usr/sbin:/usr/bin','LC_ALL':'C','HOME':'/root'}
NTFS_WORKER = ('/usr/bin/python3','-I','/usr/libexec/ro_installer_ntfs_transaction.py','--execute')
NTFS_OPERATION_TIMEOUT = 2 * 60 * 60 + 15 * 60
NTFS_SESSION_TIMEOUT = 3 * 60 * 60
AUTO_ENV = ('RO_INSTALLER_AUTO_PROFILE','RO_INSTALLER_VM_TEST_MODE',
            'RO_INSTALLER_EXTRA_KERNEL_ARGS','RO_INSTALLER_AUTO_REBOOT','DISPLAY','WAYLAND_DISPLAY',
            'XAUTHORITY','XDG_RUNTIME_DIR','DBUS_SESSION_BUS_ADDRESS',
            'GDK_BACKEND','LIBGL_ALWAYS_SOFTWARE')


def warn(code):
    try:sys.stderr.write(code+'\n')
    except (OSError,ValueError):pass


def records_module():
    loader=importlib.machinery.SourceFileLoader('ro_session_records',str(Path(__file__).with_name('ro_installer_records.py')))
    spec=importlib.util.spec_from_loader(loader.name,loader)
    module=importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def record_event(recorder,kind, *, stage=None, operation='session',status='running',duration=None,code=None,error=None):
    if recorder is None:return
    try:
        recorder.observe({'eventType':kind,'stageId':stage,'operationId':operation,
                          'status':status,'durationMs':duration,'exitCode':code,'errorCode':error},role='supervisor')
    except Exception:
        # Telemetry cannot alter admission, the engine result or resource drain.
        pass


def publish_report(recorder, result, mode, enabled, error=None):
    if recorder is None:return
    try:
        module=records_module()
        report=recorder.finish(result,error=error,remaining=len(descendants(os.getpid())))
        if enabled and module.valid_report(report):
            frame={'protocolVersion':1 if mode=='--backend' else 2,'type':'session-report','report':report}
            if mode=='--auto':sys.stdout.write('RO_INSTALLER_SESSION_REPORT ')
            sys.stdout.write(json.dumps(frame,separators=(',',':'))+'\n')
            sys.stdout.flush()
    except Exception:
        warn('SESSION_REPORT_UNAVAILABLE')
    finally:
        try:recorder.close()
        except Exception:pass


def helper_module():
    loader = importlib.machinery.SourceFileLoader('ro_session_gate', HELPER)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


class PowerInhibitError(RuntimeError):
    pass


def _power_fd(lib):
    """Take our own CLOEXEC reference to logind's borrowed reply descriptor."""
    pointer = ctypes.c_void_p
    def bind(name, arguments, result=ctypes.c_int):
        function = getattr(lib, name)
        function.argtypes = arguments
        function.restype = result
        return function
    new_bus = bind('sd_bus_new', [ctypes.POINTER(pointer)])
    address = bind('sd_bus_set_address', [pointer, ctypes.c_char_p])
    client = bind('sd_bus_set_bus_client', [pointer, ctypes.c_int])
    start = bind('sd_bus_start', [pointer])
    timeout = bind('sd_bus_set_method_call_timeout', [pointer, ctypes.c_uint64])
    call = bind('sd_bus_call_method', [pointer, ctypes.c_char_p, ctypes.c_char_p,
        ctypes.c_char_p, ctypes.c_char_p, pointer, ctypes.POINTER(pointer), ctypes.c_char_p])
    read = bind('sd_bus_message_read', [pointer, ctypes.c_char_p])
    unref_message = bind('sd_bus_message_unref', [pointer], pointer)
    unref_bus = bind('sd_bus_unref', [pointer], pointer)
    bus, reply = pointer(), pointer()
    descriptor = ctypes.c_int(-1)
    owned = None
    try:
        try:
            if new_bus(ctypes.byref(bus)) < 0 or not bus:
                raise RuntimeError('system bus unavailable')
            if address(bus, b'unix:path=/run/dbus/system_bus_socket') < 0 or client(bus, 1) < 0:
                raise RuntimeError('system bus setup failed')
            if timeout(bus, 5_000_000) < 0:
                raise RuntimeError('bus deadline unavailable')
            if start(bus) < 0:
                raise RuntimeError('system bus connection failed')
            result = call(bus, b'org.freedesktop.login1', b'/org/freedesktop/login1',
                b'org.freedesktop.login1.Manager', b'Inhibit', None, ctypes.byref(reply), b'ssss',
                ctypes.c_char_p(b'sleep:shutdown'), ctypes.c_char_p(b'Ro Installer'),
                ctypes.c_char_p(b'Installation in progress'), ctypes.c_char_p(b'block'))
            if result < 0 or not reply or read(reply, b'h', ctypes.byref(descriptor)) != 1 or descriptor.value < 3:
                raise RuntimeError('power inhibition unavailable')
            owned = fcntl.fcntl(descriptor.value, fcntl.F_DUPFD_CLOEXEC, 3)
        finally:
            try:
                if reply: unref_message(reply)
            finally:
                if bus: unref_bus(bus)
    except BaseException:
        if owned is not None: os.close(owned)
        raise
    return owned


@contextlib.contextmanager
def power_inhibitor():
    # Root session owns this capability through engine and descendant cleanup.
    # No GUI environment selects a bus, provider, action or inhibitor mode.
    try:
        descriptor = _power_fd(ctypes.CDLL('/usr/lib64/libsystemd.so.0'))
    except Exception:
        raise PowerInhibitError('POWER_INHIBIT_FAILED') from None
    try:
        yield
    finally:
        os.close(descriptor)


def private_namespace():
    before = os.readlink('/proc/self/ns/mnt')
    os.unshare(os.CLONE_NEWNS)
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.mount(None, b'/', None, 16384 | 262144, None) != 0:
        raise OSError(ctypes.get_errno(), 'private propagation failed')
    after = os.readlink('/proc/self/ns/mnt')
    if after == before:
        raise RuntimeError('namespace did not change')
    verify_private(after)
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        raise OSError(ctypes.get_errno(), 'subreaper failed')
    return before, after


def verify_private(expected):
    if os.readlink('/proc/self/ns/mnt') != expected:
        raise RuntimeError('namespace changed')
    rows = Path('/proc/self/mountinfo').read_text().splitlines()
    if not rows:
        raise RuntimeError('missing mount inventory')
    for row in rows:
        fields = row.split()
        split = fields.index('-')
        if split < 6 or any(p.startswith(('shared:', 'master:', 'propagate_from:')) for p in fields[6:split]):
            raise RuntimeError('non-private propagation')


@contextlib.contextmanager
def session_lock(gate, mode):
    if mode == '--auto':
        with gate.InstallerLock() as lock:
            yield lock.fd
        return
    # A capability inherited from the GUI helper; do not reopen or unlock it.
    anchor = os.stat(gate.LOCK_DIRECTORY + '/install.lock', follow_symlinks=False)
    for name in os.listdir('/proc/self/fd'):
        fd = int(name)
        try:
            info = os.fstat(fd)
        except OSError:
            continue
        if (info.st_dev, info.st_ino) == (anchor.st_dev, anchor.st_ino):
            gate.InstallerLock().trusted(fd)
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            yield fd
            return
    raise RuntimeError('missing helper lease')


def descendants(pid):
    result = set()
    for task in Path(f'/proc/{pid}/task').glob('*'):
        try:
            children = (task / 'children').read_text().split()
        except OSError:
            continue
        for raw in children:
            child = int(raw)
            result.add(child)
            result.update(descendants(child))
    return result


def kill_owned_children(exclude=()):
    # pidfds avoid signalling a reused PID. Only this supervisor's descendants.
    killed=False
    for pid in descendants(os.getpid()) - set(exclude):
        try:
            fd = os.pidfd_open(pid)
            try:
                if pid in descendants(os.getpid()):
                    signal.pidfd_send_signal(fd, signal.SIGKILL)
                    killed=True
            finally:
                os.close(fd)
        except ProcessLookupError:
            pass
    return killed


def safe_target_path():
    try:
        info=os.lstat('/mnt')
        return stat.S_ISDIR(info.st_mode) and info.st_uid==0 and not stat.S_IMODE(info.st_mode)&0o022
    except FileNotFoundError:
        return True


def verify_mount_target(target):
    # A copied directory must never redirect a fixed mount path through a
    # symlink. Namespace isolation does not isolate underlying file contents.
    if str(Path(target)) != target or '..' in Path(target).parts or (target != '/mnt' and not target.startswith('/mnt/')):
        raise RuntimeError('invalid mount target')
    current=Path('/')
    for part in Path(target).parts[1:]:
        current=current/part
        info=current.lstat()
        if not stat.S_ISDIR(info.st_mode):
            raise RuntimeError('mount target contains symlink/non-directory')



class Supervisor:
    def __init__(self, gate, lease, before, namespace, directory, recorder=None):
        self.recorder = recorder
        self.gate, self.lease = gate, lease
        self.before, self.namespace = before, namespace
        self.directory = directory
        self.socket = socket.socket(socket.AF_UNIX)
        self.path = directory + '/commands.sock'
        self.socket.bind(self.path)
        self.socket.listen(8)
        self.socket.settimeout(.2)
        self.stop = threading.Event()
        self.threads = []
        self.serial = threading.Lock()
        self.storage_condition = threading.Condition()
        self.storage_active = self.storage_failed = self.ntfs_attempted = False
        self.storage_accepting = True
        self.engine = None
        self.expected = None
        self.system = gate.System()
        self.system.lease_fd = lease

    def serve(self):
        while not self.stop.is_set():
            try:
                connection, _ = self.socket.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            # Completed telemetry/control requests must not accumulate one
            # retained Thread object per event during a long installation.
            self.threads = [worker for worker in self.threads if worker.is_alive()]
            if len(self.threads) >= 32:
                connection.close()
                continue
            thread = threading.Thread(target=self.client, args=(connection,))
            self.threads.append(thread)
            thread.start()

    def client(self, connection):
        with connection:
            connection.settimeout(10)
            stream = connection.makefile('rwb', buffering=0)
            write_lock = threading.Lock()
            def emit(data):
                encoded = json.dumps(data, separators=(',',':')).encode() + b'\n'
                with write_lock:
                    stream.write(encoded)
            try:
                pid, uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                if uid != os.geteuid() or self.engine is None or pid != self.engine.pid:
                    raise RuntimeError('invalid session client')
                raw = stream.readline(1024 * 1024 + 1)
                if len(raw) > 1024 * 1024 or not raw.endswith(b'\n'):
                    raise RuntimeError('invalid session frame')
                request = json.loads(raw)
                verify_private(self.namespace)
                with self.serial:
                    op = request.get('op')
                    if op == 'describe' and set(request) == {'op'}:
                        emit({'namespace':self.namespace,'parentNamespace':self.before,'lease':True,
                              'targetSafe':safe_target_path()})
                    elif op == 'validate-target' and set(request) == {'op','disk','commit'}:
                        identity = self.gate.validate_device(self.system, request['disk'])
                        if request['commit'] is False and self.expected is None:
                            self.expected = identity
                        elif request['commit'] is not True or identity != self.expected:
                            raise RuntimeError('target identity changed')
                        emit({'device':identity.public()})
                    elif op == 'idle' and set(request) == {'op'}:
                        emit({'idle':descendants(os.getpid()) == {self.engine.pid}})
                    elif op == 'ntfs-transaction' and set(request) == {'op','approvedPlan'}:
                        self.ntfs_transaction(request['approvedPlan'], emit)
                    elif op == 'observe' and set(request) == {'op','event'}:
                        recorded=False
                        if self.recorder is not None:
                            try:recorded=self.recorder.observe(request['event'])
                            except Exception:pass
                        emit({'recorded':recorded})
                    elif op == 'outcome' and set(request) == {'op','outcome'}:
                        recorded=False
                        if self.recorder is not None:
                            try:recorded=self.recorder.outcome(request['outcome'])
                            except Exception:pass
                        emit({'recorded':recorded})
                    elif op == 'command':
                        self.command(request, emit)
                    else:
                        raise RuntimeError('invalid operation')
            except Exception:
                try:
                    emit({'error':'SESSION_ERROR'})
                except OSError:
                    pass
            finally:
                stream.close()

    def ntfs_transaction(self, approved_plan, emit):
        """Drain a dedicated storage worker even if its engine/socket disappears."""
        spec = importlib.util.spec_from_file_location('ro_session_ntfs',
            Path(__file__).with_name('ro_installer_ntfs_commit.py'))
        core = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(core)
        process, threads, output = None, [], bytearray()
        errors, cleanup_errors = threading.Event(), threading.Event()
        result = core.ntfs_unknown_outcome(started=False)
        measured = time.monotonic()
        deadline, code, leaked = measured + NTFS_OPERATION_TIMEOUT, -1, False
        with self.storage_condition:
            if self.stop.is_set() or not self.storage_accepting or self.ntfs_attempted or self.storage_failed:
                self.storage_failed = True
                raise RuntimeError('storage session cannot start')
            self.ntfs_attempted = self.storage_active = True
        try:
            approved = core.gpt.normalize_ntfs_approval(approved_plan)
            device = approved['proposal']['snapshot']['device']
            if (self.expected is None or self.expected.public() != device
                    or self.gate.validate_device(self.system, device['path']) != self.expected):
                raise RuntimeError('storage target changed')
            encoded = json.dumps({'namespace':self.namespace,'parentNamespace':self.before,
                'approvedPlan':approved}, separators=(',',':')).encode()
            if len(encoded) > 16384: raise RuntimeError('storage frame limit')
            process = subprocess.Popen(NTFS_WORKER, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, close_fds=True, pass_fds=(self.lease,), env=ROOT_ENV,
                start_new_session=True)
            def read(pipe, capture):
                try:
                    while chunk := os.read(pipe.fileno(), 4096):
                        if not capture or len(output) + len(chunk) > 8192:
                            errors.set()  # Drain, never log diagnostics or cancel a writer.
                        else: output.extend(chunk)
                except OSError: errors.set()
                finally:
                    try: pipe.close()
                    except OSError: cleanup_errors.set()
            def write():
                try:
                    process.stdin.write(encoded)
                    process.stdin.flush()
                except OSError: errors.set()
                finally:
                    try: process.stdin.close()
                    except OSError: cleanup_errors.set()
            threads = [threading.Thread(target=read,args=(process.stdout,True)),
                       threading.Thread(target=read,args=(process.stderr,False)),threading.Thread(target=write)]
            for thread in threads: thread.start()
        except Exception:
            errors.set()
            if process is not None and (len(threads) < 3 or threads[-1].ident is None):
                # No stdin writer started: EOF lets the fixed worker refuse its
                # empty/incomplete frame without waiting out the write budget.
                try: process.stdin.close()
                except OSError: cleanup_errors.set()
        finally:
            if process is not None:
                try:
                    interrupted = False
                    while True:
                        try:
                            code = process.wait(timeout=None if interrupted else max(.01, deadline-time.monotonic()))
                            if interrupted: code = -124
                            break
                        except subprocess.TimeoutExpired:
                            interrupted = True
                            errors.set()
                            try: process.kill()
                            except OSError: cleanup_errors.set()
                        except OSError:
                            cleanup_errors.set()
                            if time.monotonic() >= deadline:
                                interrupted = True
                                try: process.kill()
                                except OSError: pass
                            time.sleep(.01)
                    leaked = kill_owned_children(exclude=(self.engine.pid,))
                    if leaked: errors.set()
                    for thread in threads:
                        if thread.ident is not None: thread.join()
                    for stream in (process.stdin,process.stdout,process.stderr):
                        if not stream.closed: stream.close()
                    if not errors.is_set() and not cleanup_errors.is_set():
                        value = json.loads(bytes(output).decode('utf-8'),object_pairs_hook=self.gate.unique_object,
                            parse_constant=lambda _: (_ for _ in ()).throw(ValueError('nonfinite terminal')))
                        result = core.normalize_ntfs_outcome(value, approved, code)
                    else: result = core.ntfs_unknown_outcome(cleanup_failed=leaked or cleanup_errors.is_set())
                except Exception:
                    result = core.ntfs_unknown_outcome(cleanup_failed=leaked or cleanup_errors.is_set())
            with self.storage_condition:
                self.storage_failed = self.storage_failed or errors.is_set() or result['status'] != 'success'
                self.storage_active = False
                self.storage_condition.notify_all()
            try: emit({'result':result})
            except Exception:
                errors.set()
                with self.storage_condition: self.storage_failed = True
            record_event(self.recorder,'command.end',operation='unclassified',
                status='failed' if self.storage_failed else 'success',
                duration=min(86400000,max(0,int((time.monotonic()-measured)*1000))),
                code=code if not errors.is_set() and not cleanup_errors.is_set() else -126,
                error='COMMAND_FAILED' if self.storage_failed else None)

    def command(self, request, emit):
        if set(request) != {'op','command','args','stdin','timeoutMs'}:
            raise RuntimeError('invalid command')
        command, args = request['command'], request['args']
        if (not isinstance(command,str) or not command or '\0' in command or
                not isinstance(args,list) or not all(isinstance(a,str) and '\0' not in a for a in args) or
                request['stdin'] is not None and not isinstance(request['stdin'],str) or
                request['timeoutMs'] is not None and (type(request['timeoutMs']) is not int or request['timeoutMs'] <= 0)):
            raise RuntimeError('invalid command fields')
        if command in ('mount','umount'):
            if not args:raise RuntimeError('missing mount target')
            verify_mount_target(args[-1])
        measured=time.monotonic_ns()
        try:
            process = subprocess.Popen([command,*args], stdin=subprocess.PIPE if request['stdin'] is not None else subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=ROOT_ENV, close_fds=True, pass_fds=(self.lease,),
                text=True,encoding='utf-8',errors='replace')
        except OSError:
            record_event(self.recorder,'command.end',operation='unclassified',status='failed',duration=0,code=-1,error='COMMAND_FAILED')
            emit({'started':False,'exitCode':-1})
            return
        errors = []
        def pump(pipe, name):
            try:
                while data := pipe.readline(16384):
                    emit({'stream':name,'data':data})
            except OSError as error:
                errors.append(error)
                process.kill()
            finally:
                pipe.close()
        pumps=[threading.Thread(target=pump,args=(process.stdout,'stdout')),
               threading.Thread(target=pump,args=(process.stderr,'stderr'))]
        for thread in pumps:thread.start()
        try:
            if process.stdin is not None:
                try:process.stdin.write(request['stdin'])
                finally:process.stdin.close()
            try:
                status=process.wait(timeout=None if request['timeoutMs'] is None else request['timeoutMs']/1000)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
                status=-124
            if kill_owned_children(exclude=(self.engine.pid,)):
                status=-125
            for thread in pumps:thread.join()
            if errors:raise RuntimeError('command transport lost')
            record_event(self.recorder,'command.end',
                stage=self.recorder.current_stage if self.recorder else None,
                operation=self.recorder.current_operation if self.recorder else 'unclassified',
                status='success' if status==0 else 'failed',duration=min(86400000,max(0,(time.monotonic_ns()-measured)//1000000)),
                code=status,error=None if status==0 else 'COMMAND_FAILED')
            emit({'started':True,'exitCode':status})
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()
            kill_owned_children(exclude=(self.engine.pid,))
            for thread in pumps:thread.join()

    def run(self, argv, env):
        # Starts after namespace/private propagation; no engine-controlled env/argv from GUI.
        self.engine = subprocess.Popen(argv, stdin=sys.stdin.buffer,stdout=sys.stdout.buffer,
            stderr=sys.stderr.buffer,env=env,close_fds=True,pass_fds=(self.lease,))
        record_event(self.recorder,'span.start',operation='engine',duration=0)
        server=threading.Thread(target=self.serve)
        server.start()
        measured=time.monotonic()
        status,leaked=9,False
        try:
            try:
                status=self.engine.wait(timeout=self.gate.BACKEND_TIMEOUT)
            except subprocess.TimeoutExpired:
                with self.storage_condition:
                    extended=self.ntfs_attempted
                    if not extended:
                        self.storage_accepting=False
                        self.stop.set()
                if extended:
                    try: status=self.engine.wait(timeout=max(.01,NTFS_SESSION_TIMEOUT-(time.monotonic()-measured)))
                    except subprocess.TimeoutExpired:
                        self.engine.kill();self.engine.wait();status=9
                else:
                    self.engine.kill();self.engine.wait();status=9
            with self.storage_condition:
                leaked=self.storage_active
            leaked=leaked or bool(descendants(os.getpid()))
        finally:
            with self.storage_condition:
                self.storage_accepting=False
                self.stop.set()
            self.socket.close()
            server.join()
            with self.storage_condition:
                while self.storage_active: self.storage_condition.wait()
            kill_owned_children()
            for thread in self.threads:thread.join()
            while True:
                try:os.waitpid(-1,0)
                except ChildProcessError:break
        return 9 if leaked or self.storage_failed else status


def main():
    sys.dont_write_bytecode=True
    started_ns=time.monotonic_ns()
    if os.geteuid()!=0 or sys.argv[1:] not in (['--backend'],['--auto']):
        return 9
    mode=sys.argv[1]
    argv=BACKEND if mode=='--backend' else AUTO
    if mode=='--auto' and 'RO_INSTALLER_AUTO_EXECUTABLE' in os.environ:
        candidate=os.environ['RO_INSTALLER_AUTO_EXECUTABLE']
        # Continue the exact already-running root binary (including VM builds).
        # No GUI/helper field selects an executable. Reject a different inode.
        try:
            if not os.path.isabs(candidate) or not os.path.samefile(candidate,f'/proc/{os.getppid()}/exe'):
                return 9
            argv=(candidate,)
        except OSError:
            return 9
    gate=helper_module()
    env=dict(ROOT_ENV)
    if mode=='--auto':
        env.update({key:os.environ[key] for key in AUTO_ENV if key in os.environ})
        if not env.get('RO_INSTALLER_AUTO_PROFILE'):return 9
    recorder=None
    result=9
    error=None
    mode_report=mode=='--auto' or os.environ.get('RO_INSTALLER_SESSION_REPORT')=='2'
    reboot=mode=='--auto' and os.environ.get('RO_INSTALLER_AUTO_REBOOT','').strip().lower() in ('1','true','yes','on')
    if mode=='--auto':env['RO_INSTALLER_AUTO_REBOOT']='0'
    try:
        os.umask(0o077)
        if os.getpgrp()!=os.getpid():os.setsid()
        with session_lock(gate,mode) as lease:
            try:recorder=records_module().Recorder(started_ns=started_ns)
            except Exception:pass
            record_event(recorder,'session.start',duration=0)
            try:
                before,namespace=private_namespace()
            except Exception:
                error='NAMESPACE_FAILED'
                raise
            record_event(recorder,'namespace.end',operation='namespace',status='success',duration=0)
            try:
                with power_inhibitor():
                    directory=tempfile.mkdtemp(prefix='session-',dir=gate.LOCK_DIRECTORY)
                    try:
                        session=Supervisor(gate,lease,before,namespace,directory,recorder=recorder)
                        env[SESSION_ENV]=session.path
                        result=session.run(argv,env)
                    finally:
                        shutil.rmtree(directory)
            except PowerInhibitError:
                error='POWER_INHIBIT_FAILED'
                warn(error)
                raise
            # Checkpoint and publish before optional reboot, with the original
            # installation lease still held. The engine cannot reboot first.
            publish_report(recorder,result,mode,mode_report,error)
            recorder=None
            if reboot and result==0:
                try:
                    subprocess.run(['/usr/bin/systemctl','reboot'],env=ROOT_ENV,
                        pass_fds=(lease,),stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,timeout=30,check=False)
                except (OSError,subprocess.TimeoutExpired):
                    warn('AUTO_REBOOT_FAILED')
                    result=1
    except Exception:
        warn('SESSION_INITIALIZATION_FAILED')
        result=9
    finally:
        publish_report(recorder,result,mode,mode_report,error)
    return result


if __name__=='__main__':
    sys.exit(main())
